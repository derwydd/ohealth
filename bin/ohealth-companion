#!/bin/bash
# Advertise OHealth on the local network and accept a paired iPhone.
set -euo pipefail
source="$(readlink -f "$0")"
dir="$(cd "$(dirname "$source")/.." && pwd)"
py="$dir/.venv/bin/python"
if [[ ! -x "$py" ]]; then
  py="$(command -v python3)"
fi
exec "$py" "$dir/bin/ohealth_companion.py" "$@"
